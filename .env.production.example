# Скопируйте в .env рядом с docker-compose.yml и заполните.
#   cp .env.production.example .env

# Домен, на котором будет работать панель (A-запись должна указывать на IP сервера)
DOMAIN=admin.gabrileon.ru

# Пароль базы данных — придумайте длинный случайный
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_USER=gabrileon
POSTGRES_DB=gabrileon

# Секрет для подписи токенов — обязательно сгенерируйте:
#   openssl rand -hex 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_48
JWT_TTL=12h

# Автобэкап базы (папка ./backups). Период в секундах (300 = каждые 5 минут).
# Можно уменьшить, например 120 = каждые 2 минуты. pg_dump лёгкий, это не грузит.
BACKUP_INTERVAL=300
# Сколько последних копий и суточных срезов хранить
BACKUP_RECENT_KEEP=288
BACKUP_DAILY_KEEP=30

# --- Выгрузка бэкапов в облако (необязательно, но очень желательно) ---
# Копия базы будет улетать в ваш Яндекс.Диск — если погибнет сервер, данные целы.
# Как получить пароль приложения:
#   1) Откройте id.yandex.ru → «Безопасность» → «Пароли приложений».
#   2) Создайте пароль с типом «WebDAV» (или «Файлы»). Это НЕ основной пароль!
#   3) Впишите логин и этот пароль ниже и поставьте CLOUD_UPLOAD=yadisk.
CLOUD_UPLOAD=
YADISK_USER=
YADISK_PASS=
YADISK_DIR=gabrileon-backups
UPLOAD_INTERVAL=3600
