# Скопируйте в .env и заполните своими значениями
# Строка подключения к PostgreSQL
DATABASE_URL=postgres://gabrileon:gabrileon@127.0.0.1:5432/gabrileon

# Секрет для подписи JWT (обязательно смените в проде на длинную случайную строку)
JWT_SECRET=change-me-to-a-long-random-string
# Время жизни токена доступа
JWT_TTL=12h

# Порт сервера
PORT=4000

# Разрешённые источники для CORS (через запятую). Пусто = same-origin only.
CORS_ORIGINS=

# Режим окружения
NODE_ENV=development
