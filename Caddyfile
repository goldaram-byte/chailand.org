# ─────────────────────────────────────────────────────────────────────────────
# Свой сертификат: Caddy сам получает и обновляет HTTPS (Let's Encrypt) для
# каждого домена — без Cloudflare-прокси между посетителем и сервером. Домены
# в Cloudflare должны стоять в режиме DNS only (серое облако), не Proxied,
# иначе ACME-проверка (HTTP-01, порт 80) не дойдёт до этого сервера.
#
# Маршрутизация по имени хоста:
#   chailand.org        → статический сайт-лендинг парка (репозиторий gabrileon)
#   chailand.org/lk     → клиентское приложение «личный кабинет» (PWA, app:4000)
#   lk.chailand.org     → короткий вход в личный кабинет (redirect на /lk)
#   admin.chailand.org  → админ-панель / касса (Node-приложение app:4000)
# ─────────────────────────────────────────────────────────────────────────────

# Публичный сайт-лендинг парка (статические файлы из папки ./site).
chailand.org {
	encode gzip
	# Заявки с форм сайта → в приложение (тот же origin, без CORS).
	@publicapi path /api/public/*
	reverse_proxy @publicapi app:4000
	# Клиентское приложение (личный кабинет) и его API → приложение.
	@lk path /lk /lk/* /api/client/*
	reverse_proxy @lk app:4000
	root * /srv/site
	file_server
}

# Короткий адрес личного кабинета: lk.chailand.org → chailand.org/lk/
lk.chailand.org {
	redir https://chailand.org/lk/ permanent
}

# www → без www
www.chailand.org {
	redir https://chailand.org{uri} permanent
}

# Админ-панель и касса.
admin.chailand.org {
	encode gzip
	reverse_proxy app:4000
}

# Доступ по IP-адресу сервера (диагностика) → админка.
:80 {
	encode gzip
	reverse_proxy app:4000
}
